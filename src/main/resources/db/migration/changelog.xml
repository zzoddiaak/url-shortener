<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" author="developer">
        <createTable tableName="url_mappings">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="short_url" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="original_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="alias" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="click_count" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_short_url" tableName="url_mappings">
            <column name="short_url"/>
        </createIndex>

        <createIndex indexName="idx_alias" tableName="url_mappings">
            <column name="alias"/>
        </createIndex>

        <createIndex indexName="idx_expires_at" tableName="url_mappings">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>